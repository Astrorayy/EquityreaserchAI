# ============================================================================
# Equity Research AI - environment template
# Copy this file to ".env" and fill in the values you actually have.
# Every variable below is OPTIONAL: the application runs without any of them.
# ============================================================================

# --- Application -----------------------------------------------------------
# Language of the interface: fr (default) or en
ERAI_LANG=fr
# HTTP timeout in seconds for outbound requests
ERAI_HTTP_TIMEOUT=20
# Minimum delay between two requests to the same host, in seconds
ERAI_HTTP_MIN_INTERVAL=1.0
# Directory for the SQLite database and the on-disk HTTP cache
ERAI_DATA_DIR=./data

# --- SEC EDGAR (US official filings) ---------------------------------------
# The SEC requires a descriptive User-Agent with a contact e-mail.
# https://www.sec.gov/os/webmaster-faq#developers
ERAI_SEC_USER_AGENT=equity-research-ai/0.1 (your.email@example.com)
ERAI_SEC_TICKER_MAP=https://www.sec.gov/files/company_tickers.json

# --- Web search provider (Tier 2 supplementary research) -------------------
# Which provider to use. One of: none | duckduckgo | tavily | brave | serper
# "none" (default) disables web search entirely; the rest of the app works.
# "duckduckgo" needs NO API key: it uses the `ddgs` package (installed with
# requirements.txt). Tavily/Brave/Serper require ERAI_SEARCH_API_KEY below.
ERAI_SEARCH_PROVIDER=none
# API key for the selected provider (not needed for duckduckgo)
ERAI_SEARCH_API_KEY=
# Maximum number of results returned per query
ERAI_SEARCH_MAX_RESULTS=8

# --- LLM provider for the AI research assistant ----------------------------
# Any OpenAI-compatible chat-completions endpoint works.
# Leave ERAI_LLM_API_KEY empty to keep the AI assistant disabled.
#
# Examples:
#   OpenAI            : https://api.openai.com/v1          model gpt-4o-mini
#   Groq (free tier)  : https://api.groq.com/openai/v1     model llama-3.3-70b-versatile
#   Google Gemini     : https://generativelanguage.googleapis.com/v1beta/openai
#   OpenRouter        : https://openrouter.ai/api/v1       model meta-llama/llama-3.3-70b-instruct:free
#   Mistral           : https://api.mistral.ai/v1          model mistral-small-latest
#   Ollama (local)    : http://localhost:11434/v1          model llama3.1
ERAI_LLM_PROVIDER=custom
ERAI_LLM_BASE_URL=https://api.openai.com/v1
ERAI_LLM_API_KEY=
ERAI_LLM_MODEL=gpt-4o-mini
ERAI_LLM_TEMPERATURE=0.2
ERAI_LLM_MAX_TOKENS=1500
ERAI_LLM_TIMEOUT=90

# --- Market data (US tickers only, indicative) -----------------------------
# yfinance is an UNOFFICIAL source. Set to false to disable it entirely and
# rely on manual price entry instead.
ERAI_ENABLE_YFINANCE=true
